# ExamTopics session cookie
# Copy from browser DevTools: Network tab → any request → Headers → Cookie
#
# Required cookies:
#   - sessionid: Django session (login authentication)
#   - cf_clearance: Cloudflare bot protection
#   - csrftoken: Django CSRF protection
#
# Example:
EXAMTOPICS_COOKIE="sessionid=abc123xyz; cf_clearance=xxxx-xxxxx-xxxxx; csrftoken=yyyy"

# Output directory (default: output)
# EXAMTOPICS_OUTPUT="./my-output"

# Output formats: html, pdf, markdown, json (space separated)
# EXAMTOPICS_FORMAT="html pdf markdown json"

# Delay between requests in seconds (default: 1.0)
# EXAMTOPICS_DELAY="1.5"

# Loading mode: paginated (default), bulk, range, auto
# - paginated: 50 questions per page (default)
# - bulk: Load all questions at once via custom-view
# - range: Load in batches using range filter
# - auto: Try bulk → range → paginated (recommended)
# EXAMTOPICS_MODE="auto"

# Batch size for range mode (default: 100)
# EXAMTOPICS_BATCH_SIZE="100"

# Include discussion comments (default: false)
# Warning: This makes an additional API request per question
# EXAMTOPICS_DISCUSSIONS="true"
